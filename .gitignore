:root {
  --bg: #07111f;
  --bg-soft: #0d1b2a;
  --panel: rgba(15, 23, 42, 0.72);
  --panel-alt: rgba(17, 24, 39, 0.9);
  --card: rgba(18, 35, 52, 0.9);
  --line: rgba(148, 163, 184, 0.2);
  --text: #ecf3ff;
  --muted: #a9bed7;
  --primary: #79e0ff;
  --primary-strong: #38bdf8;
  --accent: #8b5cf6;
  --success: #34d399;
  --shadow: 0 24px 60px rgba(15, 23, 42, 0.45);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(121, 224, 255, 0.14), transparent 22%),
    radial-gradient(circle at top right, rgba(139, 92, 246, 0.2), transparent 24%),
    var(--bg);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

button {
  border: none;
  cursor: pointer;
}

.page-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
  padding-bottom: 72px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 24px 0 18px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #03131d;
  font-weight: 800;
  box-shadow: var(--shadow);
}

.brand-name {
  display: block;
  font-weight: 700;
}

.brand-wrap small {
  display: block;
  color: var(--muted);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 10px;
}

.nav {
  display: flex;
  gap: 28px;
  color: var(--muted);
  font-size: 0.96rem;
}

.primary-btn,
.secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-weight: 700;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary), #a5f3fc);
  color: #071827;
  padding: 0.9rem 1.4rem;
  box-shadow: 0 18px 30px rgba(56, 189, 248, 0.25);
}

.secondary-btn {
  background: rgba(148, 163, 184, 0.09);
  border: 1px solid var(--line);
  color: var(--text);
  padding: 0.9rem 1.3rem;
}

.primary-btn.compact {
  padding: 0.8rem 1.2rem;
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-1px);
}

.hero {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 32px;
  align-items: center;
  padding: 42px 0 26px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 18px;
  border-radius: 999px;
  padding: 0.45rem 0.8rem;
  background: rgba(121, 224, 255, 0.08);
  border: 1px solid rgba(121, 224, 255, 0.18);
  color: var(--primary);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.eyebrow.dark {
  background: rgba(139, 92, 246, 0.08);
  border-color: rgba(139, 92, 246, 0.18);
  color: #d4b8ff;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.5rem, 5vw, 5rem);
  line-height: 1.04;
  letter-spacing: -0.06em;
}

.hero-copy p {
  max-width: 640px;
  color: var(--muted);
  line-height: 1.75;
  font-size: 1.04rem;
  margin: 22px 0 28px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(680px, 100%);
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 10px 12px 10px 16px;
  box-shadow: var(--shadow);
}

.search-box input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 1rem;
}

.search-box input::placeholder {
  color: #93a7c1;
}

.stats-row {
  display: flex;
  gap: 34px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.stats-row div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stats-row strong {
  font-size: 1.7rem;
  letter-spacing: -0.04em;
}

.stats-row span {
  color: var(--muted);
}

.hero-panel {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.mini-card {
  border-radius: 28px;
  padding: 24px;
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}

.glass {
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.8), rgba(30, 41, 59, 0.72));
}

.accent {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.16), rgba(56, 189, 248, 0.12));
}

.tiny-label {
  display: inline-block;
  color: var(--primary);
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.mini-card h3 {
  margin: 0 0 10px;
  font-size: 2rem;
}

.mini-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}

.chip {
  border-radius: 999px;
  padding: 0.45rem 0.75rem;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(121, 224, 255, 0.25);
  color: var(--text);
  font-size: 0.78rem;
}

.feature-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-top: 18px;
}

.feature-card,
.career-card,
.roadmap-panel,
.insight-panel {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.feature-card {
  padding: 22px 20px;
}

.feature-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(121, 224, 255, 0.14), rgba(139, 92, 246, 0.14));
  color: var(--primary);
  margin-bottom: 12px;
}

.feature-card h3,
.section-heading h2 {
  margin: 0 0 10px;
}

.feature-card p,
.career-card p,
.roadmap-item p,
.insight-panel li,
.insight-panel p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.career-section,
.journey-section {
  padding-top: 74px;
}

.section-heading {
  margin-bottom: 26px;
}

.section-heading.left {
  text-align: left;
}

.section-heading h2 {
  font-size: clamp(2rem, 3vw, 3rem);
  letter-spacing: -0.05em;
}

.career-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.career-card {
  padding: 20px;
}

.career-topline {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin-bottom: 18px;
}

.career-tag {
  display: inline-block;
  border-radius: 999px;
  padding: 0.45rem 0.7rem;
  background: rgba(139, 92, 246, 0.1);
  color: #dec4ff;
  font-size: 0.72rem;
  border: 1px solid rgba(139, 92, 246, 0.18);
}

.match-score {
  color: var(--success);
  font-weight: 700;
}

.career-card h3 {
  margin: 0 0 12px;
  font-size: 1.5rem;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 22px;
  gap: 10px;
}

.meta-row strong {
  font-size: 1.2rem;
}

.meta-row span {
  color: var(--muted);
  text-align: right;
}

.journey-layout {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 22px;
}

.roadmap-panel {
  padding: 22px;
}

.roadmap-item {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}

.roadmap-item:last-child {
  border-bottom: none;
}

.step-number {
  display: inline-grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(121, 224, 255, 0.12), rgba(139, 92, 246, 0.12));
  color: var(--primary);
  font-weight: 700;
}

.insight-panel {
  padding: 24px;
}

.insight-panel h3 {
  margin: 0 0 16px;
  font-size: 1.7rem;
}

.insight-panel ul {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: grid;
  gap: 12px;
}

.insight-panel li {
  position: relative;
  padding-left: 22px;
}

.insight-panel li::before {
  content: '•';
  position: absolute;
  left: 0;
  color: var(--primary);
  font-size: 1.2rem;
}

.cta-band {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  background: linear-gradient(135deg, rgba(121, 224, 255, 0.09), rgba(139, 92, 246, 0.12));
  border: 1px solid var(--line);
  border-radius: 32px;
  padding: 30px 28px;
  margin-top: 72px;
}

.cta-band h2 {
  margin: 0;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  letter-spacing: -0.04em;
}

@media (max-width: 980px) {
  .hero,
  .journey-layout,
  .career-grid,
  .feature-strip {
    grid-template-columns: 1fr 1fr;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .journey-layout {
    grid-template-columns: 1fr;
  }

  .career-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .topbar {
    flex-wrap: wrap;
  }

  .nav {
    order: 3;
    width: 100%;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.85rem;
  }

  .feature-strip,
  .career-grid {
    grid-template-columns: 1fr;
  }

  .cta-band {
    flex-direction: column;
    align-items: flex-start;
  }
}
